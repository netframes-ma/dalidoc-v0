+// Part of React Advanced Odontogram - https://github.com/ZoliQua/React-Advanced-Odontogram
+// Created by Zoltan Dul (https://github.com/ZoliQua) 2025-2026
+
+// Coded diagnoses in the tooltip / whole-mouth summary: English keeps the WHO
+// ICD-10 title, other languages show their own `dx.<key>` name; the code stays.
+import { describe, it, expect, afterEach } from "vitest";
+import { getOdontogramSummary, getToothStateSummary, __setToothStateForTest, __resetChartStateForTest } from "../odontogram";
+import { setI18nLanguage, t } from "../i18n/useI18n";
+
+afterEach(async () => { await setI18nLanguage("en"); __resetChartStateForTest(); });
+
+function calculusTooth() {
+  __setToothStateForTest(26, { toothSelection: "tooth-base", calculus: true });
+}
+
+describe("coded diagnosis names", () => {
+  it("English shows the WHO title with its code", async () => {
+    await setI18nLanguage("en");
+    calculusTooth();
+    expect(getToothStateSummary(26)).toContain("Deposits [accretions] on teeth (K03.6)");
+  });
+
+  it.each(["fr", "ar", "hu"] as const)("%s shows its own name with the code", async (lang) => {
+    await setI18nLanguage(lang);
+    calculusTooth();
+    const name = t("dx.calculus");
+    expect(name).not.toBe("dx.calculus");
+    const lines = getToothStateSummary(26);
+    expect(lines).toContain(`${name} (K03.6)`);
+    expect(lines.join(" ")).not.toContain("Deposits [accretions]");
+  });
+
+  it("the whole-mouth summary follows the same rule", async () => {
+    await setI18nLanguage("fr");
+    calculusTooth();
+    const text = JSON.stringify(getOdontogramSummary());
+    expect(text).toContain(`${t("dx.calculus")} (K03.6)`);
+  });
+});
diff --git a/src/odontogram.ts b/src/odontogram.ts
index e3fba84..86e0e32 100644
--- a/src/odontogram.ts
+++ b/src/odontogram.ts
@@ -2365,6 +2365,20 @@ export function getToothDiagnoses(toothNo: number): ToothDiagnosis[] {
   return list.sort((a, b) => (a.icd10 ?? "￿").localeCompare(b.icd10 ?? "￿"));
 }
 
+/**
+ * A coded diagnosis's name in the tooltip and the whole-mouth summary. English
+ * shows the WHO ICD-10 title (the official English name, refined by DX-8 —
+ * "Caries of dentine" rather than "Dental caries"); every other language shows
+ * its own `dx.<key>` name, which the active-diagnoses card already uses. The
+ * ICD-10 code stays next to it, and the FHIR export keeps the WHO title.
+ */
+function diagnosisUiName(d: ToothDiagnosis): string {
+  if(getI18nLanguage() === "en") return d.icd10Display;
+  const key = `dx.${d.key}`;
+  const name = t(key);
+  return name !== key ? name : d.icd10Display;
+}
+
 /** One row in the active-tooth diagnoses card: a RAW rule-derived key (whether
  *  or not it's currently suppressed) or a key the user explicitly ADDED that no
  *  rule would have derived. */
@@ -3902,7 +3916,7 @@ function getStateSummary(toothNo: number): string[]{
   // a rule-derived one, mirroring how "proposed" plan findings are visually
   // tagged elsewhere.
   for(const d of getToothDiagnoses(toothNo)){
-    const line = d.icd10 ? `${d.icd10Display} (${d.icd10})` : `${d.icd10Display} (${t("diagnoses.noCode")})`;
+    const line = d.icd10 ? `${diagnosisUiName(d)} (${d.icd10})` : `${diagnosisUiName(d)} (${t("diagnoses.noCode")})`;
     summary.push(d.source === "added" ? `+ ${line}` : line);
   }
 
@@ -8595,7 +8609,7 @@ export function getOdontogramSummary(): OdontogramSummary {
     // never drifts from the tooltip / active-diagnoses card). An explicitly
     // ADDED (not rule-derived) code is prefixed, mirroring the tooltip.
     for(const d of getToothDiagnoses(toothNo)){
-      const line = d.icd10 ? `${d.icd10Display} (${d.icd10})` : `${d.icd10Display} (${t("diagnoses.noCode")})`;
+      const line = d.icd10 ? `${diagnosisUiName(d)} (${d.icd10})` : `${diagnosisUiName(d)} (${t("diagnoses.noCode")})`;
       dxs.push(d.source === "added" ? `+ ${line}` : line);
     }
     if(dxs.length) diagnoses.push(`${lbl(toothNo)} (${dxs.join("; ")})`);
