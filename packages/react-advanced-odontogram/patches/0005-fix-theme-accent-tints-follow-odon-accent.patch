+// Part of React Advanced Odontogram - https://github.com/ZoliQua/React-Advanced-Odontogram
+// Created by Zoltan Dul (https://github.com/ZoliQua) 2025-2026
+
+// Accent-tinted UI colours (button tints, active states, focus rings) follow
+// the --odon-accent / --odon-accent2 theme variables instead of hard-coded
+// blues and greens; the defaults render exactly as before. Data-visualisation
+// colours (perio pocket band, heat map) are deliberately left alone.
+import { describe, it, expect } from "vitest";
+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+
+const testFileUrl = import.meta.url;
+const css = readFileSync(fileURLToPath(new URL("../index.css", testFileUrl)), "utf8");
+const lines = css.split("\n").filter((l) => !/^\s*--_odon-accent(2|-dark|-fg)?\s*:/.test(l));
+
+describe("accent colours", () => {
+  it("has no hard-coded accent tints left", () => {
+    const offenders = lines.filter((l) => /#3b7bff\b|#12b981\b|rgba\(\s*(59\s*,\s*123\s*,\s*255|96\s*,\s*165\s*,\s*250|18\s*,\s*185\s*,\s*129)\s*,/i.test(l));
+    expect(offenders).toEqual([]);
+  });
+
+  it("keeps the stock colours as the variable defaults", () => {
+    expect(css).toMatch(/--_odon-accent:\s*var\(--odon-accent, #3b7bff\)/);
+    expect(css).toMatch(/--_odon-accent2:\s*var\(--odon-accent2, #12b981\)/);
+    expect(css).toMatch(/--_odon-accent-dark:\s*var\(--odon-accent, #60a5fa\)/);
+  });
+
+  it("lets the host set the text colour on a solid accent", () => {
+    expect(css).toMatch(/--_odon-accent-fg:\s*var\(--odon-accent-fg, #fff\)/);
+    const active = css.slice(css.indexOf(".chart-mode-btn.is-active{"), css.indexOf("}", css.indexOf(".chart-mode-btn.is-active{")));
+    expect(active).toContain("color: var(--_odon-accent-fg)");
+  });
+
+  it("keeps the active perio switch visible in dark mode", () => {
+    expect(css).toContain(".dark .perio-overlay-switch-btn:not(.is-active){");
+    expect(css).toMatch(/\.dark \.perio-overlay-switch-btn\.is-active\{[^}]*background: var\(--_odon-accent-dark\)/);
+  });
+
+  it("re-resolves the accents in a nested .dark scope", () => {
+    const dark = css.slice(css.indexOf("\n.dark{"), css.indexOf("}", css.indexOf("\n.dark{")));
+    expect(dark).toContain("--_odon-accent:");
+    expect(dark).toContain("--_odon-accent-dark:");
+  });
+});
