@@ -0,0 +1,37 @@
+// Part of React Advanced Odontogram - https://github.com/ZoliQua/React-Advanced-Odontogram
+// Created by Zoltan Dul (https://github.com/ZoliQua) 2025-2026
+
+// The classic templates read the same material variables as the measured
+// donors (tools/toothgen/source), line for line, so a host theme recolours a
+// material under either anatomy. Each classic colour stays as the fallback.
+import { describe, it, expect } from "vitest";
+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+
+// Captured first so Vite does not rewrite `new URL(literal, import.meta.url)`.
+const testFileUrl = import.meta.url;
+const read = (rel: string) => readFileSync(fileURLToPath(new URL(rel, testFileUrl)), "utf8").split("\n");
+const VAR = /(fill|stroke|stop-color)\s*[:=]\s*"?var\((--odon-[a-z0-9-]+), (#[0-9a-fA-F]{3,8})\)/g;
+
+describe.each(["11", "13", "14", "14_occl", "16", "16_occl"])("classic template %s", (name) => {
+  const donor = read(`../../tools/toothgen/source/${name}.svg`);
+  const classic = read(`../assets/teeth-svgs/${name}.svg`);
+
+  it("uses every material variable the donor uses, on the same element", () => {
+    expect(classic.length).toBe(donor.length);
+    let checked = 0;
+    donor.forEach((line, i) => {
+      const wanted = [...line.matchAll(VAR)].map((m) => `${m[1]}:${m[2]}`);
+      if (wanted.length === 0) return;
+      const got = [...classic[i].matchAll(VAR)].map((m) => `${m[1]}:${m[2]}`);
+      expect(got, `line ${i + 1}`).toEqual(wanted);
+      expect(classic[i].match(/\sid="([^"]+)"/)?.[1]).toBe(line.match(/\sid="([^"]+)"/)?.[1]);
+      checked++;
+    });
+    expect(checked).toBeGreaterThan(50);
+  });
+
+  it("keeps a literal colour as every fallback", () => {
+    for (const line of classic) for (const m of line.matchAll(VAR)) expect(m[3]).toMatch(/^#[0-9a-fA-F]{3,8}$/);
+  });
+});
