diff --git a/src/__tests__/stylesheet-scope.test.ts b/src/__tests__/stylesheet-scope.test.ts
new file mode 100644
index 0000000..5facfa4
--- /dev/null
+++ b/src/__tests__/stylesheet-scope.test.ts
@@ -0,0 +1,63 @@
+// Part of React Advanced Odontogram - https://github.com/ZoliQua/React-Advanced-Odontogram
+// Created by Zoltan Dul (https://github.com/ZoliQua) 2025-2026
+
+// The shipped stylesheet must not style the host page: no html/body rules, no
+// theme variables a host might also use (--bg, --card, --accent…), no global
+// `.hidden`, and every selector confined to the component root or to the
+// engine's own `odon-*` popups by tools/postcss-scope.js.
+import { describe, it, expect } from "vitest";
+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import postcss from "postcss";
+import odontogramScope, { ODONTOGRAM_SCOPE } from "../../tools/postcss-scope.js";
+
+// Captured first so Vite does not rewrite `new URL(literal, import.meta.url)`
+// as an asset URL (same workaround as sp16-fillings-card.test.ts).
+const testFileUrl = import.meta.url;
+const cssPath = fileURLToPath(new URL("../index.css", testFileUrl));
+const source = readFileSync(cssPath, "utf8");
+const scoped = postcss([odontogramScope()]).process(source, { from: cssPath }).css;
+
+function selectors(css: string): string[] {
+  const out: string[] = [];
+  postcss.parse(css).walkRules((rule) => {
+    if (rule.parent?.type === "atrule" && /keyframes$/i.test((rule.parent as postcss.AtRule).name)) return;
+    out.push(...rule.selectors);
+  });
+  return out;
+}
+
+describe("library stylesheet scope", () => {
+  it("has no page-level rules", () => {
+    for (const s of selectors(source)) expect(s).not.toMatch(/^(html|body)\b|(^|\s)body\b/);
+  });
+
+  it("keeps its theme variables private", () => {
+    expect(source).not.toMatch(/(^|[;{\s])--(bg|panel|card|muted|text|line|accent2?)\s*:/m);
+    expect(source).not.toMatch(/var\(--(bg|panel|card|muted|text|line|accent2?)[,)]/);
+    expect(source).toMatch(/--_odon-bg\s*:/);
+  });
+
+  it("namespaces its hide utility", () => {
+    expect(source).not.toMatch(/(^|[\s,}])\.hidden\s*\{/m);
+    expect(source).toMatch(/\.odon-hidden\s*\{/);
+  });
+
+  it("confines every selector to the component or its odon-* popups", () => {
+    const unscoped = selectors(scoped).filter(
+      (s) => !s.includes(ODONTOGRAM_SCOPE) && !/^(:root|\.dark|\.odontogram-root|\.dark \.odontogram-root)$/.test(s.trim()),
+    );
+    expect(unscoped).toEqual([]);
+  });
+
+  it("puts the scope before pseudo-elements and leaves specificity alone", () => {
+    const out = postcss([odontogramScope({ include: () => true })]).process(
+      ".tooth-tile:after{} .a::before{} .dark .btn{}",
+      { from: undefined },
+    ).css;
+    expect(out).toContain(`.tooth-tile${ODONTOGRAM_SCOPE}:after`);
+    expect(out).toContain(`.a${ODONTOGRAM_SCOPE}::before`);
+    expect(out).toContain(`.dark .btn${ODONTOGRAM_SCOPE}`);
+    expect(ODONTOGRAM_SCOPE.startsWith(":where(")).toBe(true);
+  });
