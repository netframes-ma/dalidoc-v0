diff --git a/tools/postcss-scope.js b/tools/postcss-scope.js
new file mode 100644
index 0000000..01c83fd
--- /dev/null
+++ b/tools/postcss-scope.js
@@ -0,0 +1,58 @@
+// Part of React Advanced Odontogram - https://github.com/ZoliQua/React-Advanced-Odontogram
+//
+// PostCSS plugin: keeps the odontogram stylesheet inside the odontogram.
+//
+// The stylesheet is written with short, readable selectors (`.btn`, `.card`,
+// `select`, `.row`…). Shipped as-is they would also style a host page's own
+// `.btn`/`.card`/`select`. This plugin appends a zero-specificity condition to
+// the subject of every selector so a rule only matches:
+//   - inside the component root (`.odontogram-root`),
+//   - inside the popups the engine appends to <body> (every one carries an
+//     `odon-*` class).
+// `:where()` adds no specificity, so the cascade between the library's own
+// rules is unchanged. Theme-variable rules (`:root`, `.dark`,
+// `.odontogram-root`) and @keyframes are left alone.
+import selectorParser from "postcss-selector-parser";
+
+export const ODONTOGRAM_SCOPE =
+  ':where(.odontogram-root, .odontogram-root *, [class*="odon-"], [class*="odon-"] *)';
+
+const LEGACY_PSEUDO_ELEMENTS = new Set([":before", ":after", ":first-line", ":first-letter"]);
+const UNSCOPED = /^(?::root|\.dark|\.odontogram-root|\.dark \.odontogram-root)$/;
+
+const scopeNode = selectorParser().astSync(ODONTOGRAM_SCOPE).first.first;
+
+function isPseudoElement(node) {
+  return node.type === "pseudo" && (node.value.startsWith("::") || LEGACY_PSEUDO_ELEMENTS.has(node.value.toLowerCase()));
+}
+
+const transform = selectorParser((selectors) => {
+  selectors.each((selector) => {
+    if (UNSCOPED.test(selector.toString().trim())) return;
+    let start = 0;
+    selector.nodes.forEach((node, i) => {
+      if (node.type === "combinator") start = i + 1;
+    });
+    const subject = selector.nodes.slice(start);
+    if (subject.length === 0) return;
+    const pseudoElement = subject.find(isPseudoElement);
+    if (pseudoElement) selector.insertBefore(pseudoElement, scopeNode.clone());
+    else selector.append(scopeNode.clone());
+  });
+});
+
+/** @param {{ include?: (file: string) => boolean }} [options] */
+export default function odontogramScope(options = {}) {
+  const include = options.include ?? ((file) => /[\\/]src[\\/]index\.css$/.test(file));
+  return {
+    postcssPlugin: "odontogram-scope",
+    Once(root) {
+      if (!include(root.source?.input?.file ?? "")) return;
+      root.walkRules((rule) => {
+        if (rule.parent?.type === "atrule" && /keyframes$/i.test(rule.parent.name)) return;
+        rule.selector = transform.processSync(rule.selector);
+      });
+    },
+  };
+}
+odontogramScope.postcss = true;
