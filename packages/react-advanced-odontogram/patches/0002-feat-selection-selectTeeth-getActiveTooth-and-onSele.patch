 }
 
 // ---- Touch: Zoom Popover ----
@@ -8165,6 +8166,58 @@ export function clearSelection(){
 export function getSelectedTeeth(): number[] {
   return Array.from(selectedTeeth) as number[];
 }
+
+/**
+ * The active tooth — the one the editing controls show — or `null` when nothing
+ * is selected. With several teeth selected it is the one most recently added.
+ */
+export function getActiveTooth(): number | null {
+  return activeTooth && selectedTeeth.has(activeTooth) ? (activeTooth as number) : null;
+}
+
+/** Listener for {@link onSelectionChange}. */
+export type SelectionChangeListener = (teeth: number[], activeTooth: number | null) => void;
+
+const selectionListeners = new Set<SelectionChangeListener>();
+let lastSelectionKey = "";
+
+/** Fire selection listeners when the selection or the active tooth changed. */
+function emitSelectionChange(){
+  const teeth = getSelectedTeeth();
+  const active = getActiveTooth();
+  const key = `${teeth.join(",")}|${active ?? ""}`;
+  if(key === lastSelectionKey) return;
+  lastSelectionKey = key;
+  for(const listener of Array.from(selectionListeners)){
+    try{ listener(teeth.slice(), active); }
+    catch(e){ console.error("odontogram selection listener failed", e); }
+  }
+}
+
+/**
+ * Subscribe to selection changes only: the listener receives the selected teeth
+ * (FDI numbers, in selection order) and the active tooth, and runs only when
+ * one of them changed — unlike {@link onStateChange}, which also fires for every
+ * chart edit. Returns an unsubscribe function.
+ */
+export function onSelectionChange(listener: SelectionChangeListener): () => void {
+  selectionListeners.add(listener);
+  return () => { selectionListeners.delete(listener); };
+}
+
+/**
+ * Select teeth from the host (a list, a search result, a treatment plan row).
+ * Unknown tooth numbers are ignored; an empty list clears the selection. The
+ * active tooth is `options.activeTooth` when it is among `teeth`, else the last
+ * one. Works in read-only mode too: it is a programmatic selection, not an edit.
+ */
+export function selectTeeth(teeth: readonly number[], options: { activeTooth?: number } = {}): void {
+  const valid = teeth.filter((tn, i) => ALL_TEETH.includes(tn) && teeth.indexOf(tn) === i);
+  selectedTeeth = new Set(valid);
+  const wanted = options.activeTooth;
+  activeTooth = wanted !== undefined && selectedTeeth.has(wanted) ? wanted : (valid[valid.length - 1] ?? null);
+  updateSelectionUI();
+}
