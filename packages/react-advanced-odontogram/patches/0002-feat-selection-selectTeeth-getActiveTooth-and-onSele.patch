+// Part of React Advanced Odontogram - https://github.com/ZoliQua/React-Advanced-Odontogram
+// Created by Zoltan Dul (https://github.com/ZoliQua) 2025-2026
+
+// Host-driven selection: selectTeeth() selects from outside the chart (a list,
+// a plan row), getActiveTooth() reads the tooth the controls show, and
+// onSelectionChange() follows the selection without firing on chart edits.
+import { describe, it, expect, beforeEach, vi } from "vitest";
+import * as App from "../App";
+import {
+  clearSelection, getActiveTooth, getSelectedTeeth, onSelectionChange, selectTeeth,
+  __resetChartStateForTest, onStateChange,
+} from "../odontogram";
+
+beforeEach(() => { __resetChartStateForTest(); clearSelection(); });
+
+describe("selectTeeth", () => {
+  it("selects the given teeth in order and makes the last one active", () => {
+    selectTeeth([16, 26, 36]);
+    expect(getSelectedTeeth()).toEqual([16, 26, 36]);
+    expect(getActiveTooth()).toBe(36);
+  });
+
+  it("honours an explicit active tooth only when it is selected", () => {
+    selectTeeth([16, 26], { activeTooth: 16 });
+    expect(getActiveTooth()).toBe(16);
+    selectTeeth([16, 26], { activeTooth: 11 });
+    expect(getActiveTooth()).toBe(26);
+  });
+
+  it("ignores unknown and duplicate tooth numbers", () => {
+    selectTeeth([16, 99, 16, 0, 47]);
+    expect(getSelectedTeeth()).toEqual([16, 47]);
+  });
+
+  it("clears the selection with an empty list", () => {
+    selectTeeth([21]);
+    selectTeeth([]);
+    expect(getSelectedTeeth()).toEqual([]);
+    expect(getActiveTooth()).toBeNull();
+  });
+});
+
+describe("onSelectionChange", () => {
+  it("reports the selection and the active tooth", () => {
+    const listener = vi.fn();
+    const off = onSelectionChange(listener);
+    selectTeeth([11, 21]);
+    expect(listener).toHaveBeenLastCalledWith([11, 21], 21);
+    clearSelection();
+    expect(listener).toHaveBeenLastCalledWith([], null);
+    off();
+  });
+
+  it("does not fire again when nothing changed, and stops after unsubscribing", () => {
+    const listener = vi.fn();
+    const off = onSelectionChange(listener);
+    selectTeeth([31]);
+    selectTeeth([31]);
+    expect(listener).toHaveBeenCalledTimes(1);
+    off();
+    selectTeeth([32]);
+    expect(listener).toHaveBeenCalledTimes(1);
+  });
+
+  it("still notifies onStateChange listeners on a selection change", () => {
+    const state = vi.fn();
+    const off = onStateChange(state);
+    selectTeeth([44]);
+    expect(state).toHaveBeenCalled();
+    off();
+  });
+
+  it("keeps a failing listener from breaking the others", () => {
+    const error = vi.spyOn(console, "error").mockImplementation(() => {});
+    const good = vi.fn();
+    const offBad = onSelectionChange(() => { throw new Error("boom"); });
+    const offGood = onSelectionChange(good);
+    selectTeeth([13]);
+    expect(good).toHaveBeenCalledWith([13], 13);
+    offBad(); offGood(); error.mockRestore();
+  });
+});
+
+describe("public entry point", () => {
+  it("exports the selection API", () => {
+    expect(typeof App.selectTeeth).toBe("function");
+    expect(typeof App.getActiveTooth).toBe("function");
+    expect(typeof App.onSelectionChange).toBe("function");
+  });
+});
